-- 001: Artists table
CREATE TABLE IF NOT EXISTS artists (
  id          SERIAL PRIMARY KEY,
  uuid        UUID DEFAULT gen_random_uuid() UNIQUE NOT NULL,
  name        VARCHAR(255) NOT NULL,
  email       VARCHAR(255) UNIQUE NOT NULL,
  password    VARCHAR(255) NOT NULL,
  genre       VARCHAR(100),
  location    VARCHAR(255),
  bio         TEXT,
  twitter_handle     VARCHAR(100),
  instagram_handle   VARCHAR(100),
  spotify_artist_id  VARCHAR(100),
  linkedin_profile   VARCHAR(255),
  plan        VARCHAR(20) DEFAULT 'free',     -- 'free' | 'pro'
  stripe_customer_id VARCHAR(100),
  twitter_connected  BOOLEAN DEFAULT false,
  instagram_connected BOOLEAN DEFAULT false,
  spotify_connected  BOOLEAN DEFAULT false,
  auto_apply  BOOLEAN DEFAULT true,
  ai_manager  BOOLEAN DEFAULT true,
  created_at  TIMESTAMPTZ DEFAULT NOW(),
  updated_at  TIMESTAMPTZ DEFAULT NOW()
);
 
-- 002: Fans table
CREATE TABLE IF NOT EXISTS fans (
  id           SERIAL PRIMARY KEY,
  artist_id    INTEGER REFERENCES artists(id) ON DELETE CASCADE,
  username     VARCHAR(255) NOT NULL,
  display_name VARCHAR(255),
  platform     VARCHAR(20) NOT NULL,  -- 'twitter' | 'instagram' | 'spotify'
  profile_url  VARCHAR(500),
  avatar_url   VARCHAR(500),
  followers    INTEGER DEFAULT 0,
  likes_given  INTEGER DEFAULT 0,
  comments_given INTEGER DEFAULT 0,
  shares_given INTEGER DEFAULT 0,
  score        INTEGER DEFAULT 0,      -- 0–100 superfan score
  tier         VARCHAR(20) DEFAULT 'engaged',  -- 'superfan' | 'loyal' | 'engaged'
  last_active  TIMESTAMPTZ,
  is_starred   BOOLEAN DEFAULT false,
  created_at   TIMESTAMPTZ DEFAULT NOW(),
  updated_at   TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(artist_id, username, platform)
);
 
-- 003: Gigs table
CREATE TABLE IF NOT EXISTS gigs (
  id          SERIAL PRIMARY KEY,
  type        VARCHAR(30) NOT NULL,   -- 'venue' | 'sync' | 'linkedin' | 'brand'
  title       VARCHAR(500) NOT NULL,
  venue       VARCHAR(255),
  description TEXT,
  pay         VARCHAR(100),
  pay_amount  NUMERIC(10,2),
  location    VARCHAR(255),
  genre       VARCHAR(100),
  deadline    TIMESTAMPTZ,
  contact_email VARCHAR(255),
  apply_url   VARCHAR(500),
  source      VARCHAR(100),           -- where we scraped/found it
  match_score INTEGER DEFAULT 0,      -- 0–100 match to artist
  status      VARCHAR(20) DEFAULT 'open',  -- 'open' | 'closed' | 'filled'
  created_at  TIMESTAMPTZ DEFAULT NOW()
);
 
-- 004: Applications table
CREATE TABLE IF NOT EXISTS applications (
  id            SERIAL PRIMARY KEY,
  artist_id     INTEGER REFERENCES artists(id) ON DELETE CASCADE,
  gig_id        INTEGER REFERENCES gigs(id),
  resume_id     INTEGER,
  cover_letter  TEXT,
  status        VARCHAR(30) DEFAULT 'sent',  -- 'sent' | 'viewed' | 'shortlisted' | 'rejected' | 'booked'
  applied_at    TIMESTAMPTZ DEFAULT NOW(),
  response_at   TIMESTAMPTZ,
  notes         TEXT
);
 
-- 005: Campaigns table
CREATE TABLE IF NOT EXISTS campaigns (
  id              SERIAL PRIMARY KEY,
  artist_id       INTEGER REFERENCES artists(id) ON DELETE CASCADE,
  type            VARCHAR(50) NOT NULL,
  title           VARCHAR(255),
  caption         TEXT,
  dm_script       TEXT,
  hashtags        TEXT[],
  target_fan_ids  INTEGER[],
  platform        VARCHAR(20)[],
  estimated_reach INTEGER DEFAULT 0,
  actual_reach    INTEGER DEFAULT 0,
  revenue_generated NUMERIC(10,2) DEFAULT 0,
  status          VARCHAR(20) DEFAULT 'draft',  -- 'draft' | 'active' | 'completed'
  launched_at     TIMESTAMPTZ,
  created_at      TIMESTAMPTZ DEFAULT NOW()
);
 
-- 006: Resumes table
CREATE TABLE IF NOT EXISTS resumes (
  id           SERIAL PRIMARY KEY,
  artist_id    INTEGER REFERENCES artists(id) ON DELETE CASCADE,
  version      INTEGER DEFAULT 1,
  content      JSONB NOT NULL,   -- full resume data as JSON
  is_active    BOOLEAN DEFAULT true,
  created_at   TIMESTAMPTZ DEFAULT NOW()
);
 
-- Indexes for performance
CREATE INDEX IF NOT EXISTS idx_fans_artist_id ON fans(artist_id);
CREATE INDEX IF NOT EXISTS idx_fans_score ON fans(score DESC);
CREATE INDEX IF NOT EXISTS idx_fans_tier ON fans(tier);
CREATE INDEX IF NOT EXISTS idx_applications_artist_id ON applications(artist_id);
CREATE INDEX IF NOT EXISTS idx_gigs_status ON gigs(status);
CREATE INDEX IF NOT EXISTS idx_gigs_match ON gigs(match_score DESC);
CREATE INDEX IF NOT EXISTS idx_campaigns_artist_id ON campaigns(artist_id);
 